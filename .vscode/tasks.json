{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run LAB AI OS",
            "type": "shell",
            "command": "python main.py",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Plugin Discovery Test",
            "type": "shell",
            "command": "python main.py",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "pytest",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Memory Layer Test",
            "type": "shell",
            "command": "pytest tests/test_memory.py",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Lint Code (Ruff)",
            "type": "shell",
            "command": "ruff check .",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Format Code (Ruff)",
            "type": "shell",
            "command": "ruff format .",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Full System Check",
            "type": "shell",
            "command": "ruff check . && pytest && git status",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Check Git Status",
            "type": "shell",
            "command": "git status",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}